# The model. Without this there is no conversation at all.
CLAUDE_CODE_OAUTH_TOKEN=

# The voice. ElevenLabs speaks and transcribes; Fish Audio only speaks, and its
# s2.1-pro-free model does so without a character cap. One key given picks that
# service; both given, JARVIS_VOICE_PROVIDER (elevenlabs | fish) decides who
# speaks, and ElevenLabs transcribes either way. Neither leaves the HUD on
# browser speech.
ELEVENLABS_API_KEY=
JARVIS_VOICE_ID=
JARVIS_VOICE_ID_EN=
FISH_AUDIO_API_KEY=
JARVIS_VOICE_PROVIDER=
JARVIS_FISH_MODEL=
JARVIS_FISH_VOICE_ID=
JARVIS_FISH_VOICE_ID_EN=

# The house. Empty leaves the assistant with no house at all, which works.
HA_URL=
HA_TOKEN=

# The zone every weekday, hour and spoken time is worked out in, and the language
# dates and numbers are written in. Unset, the zone is this machine's own -- which
# on a container is UTC, and a house is not in UTC. The zone in use is printed at
# startup, and an unset zone on a UTC machine opens a finding about itself.
JARVIS_TIMEZONE=
JARVIS_LOCALE=

# Where it listens, and where the certificate and key are.
JARVIS_PORT=
JARVIS_CERT_DIR=

# off | observe | suggest | announce. Default off: nothing watches, no timer armed.
JARVIS_PROACTIVE=

# off | read | edit. How much of the memory the HUD may see and change. Ships at
# read: the port has no authentication of its own, so edit is a decision.
JARVIS_MEMORY_PANEL=

# What to call the person this assistant belongs to.
JARVIS_OWNER=

# A written notice through the house. The service defaults to notify.send_message,
# which every notify entity answers; name another one if yours wants more.
JARVIS_NOTIFY_ENTITY=
JARVIS_NOTIFY_SERVICE=
JARVIS_NOTIFY_DATA=

# The channel that can answer back. A bot token and the chat findings go to;
# without both, `suggest` detects and records and asks nobody. How many may be
# sent in a rolling day, and the local hours to stay quiet in (equal = never).
JARVIS_TELEGRAM_TOKEN=
JARVIS_TELEGRAM_CHAT=
JARVIS_SUGGEST_PER_DAY=
JARVIS_QUIET_FROM=
JARVIS_QUIET_TO=

# House Ops triage for ripe anomalies. When set, Core POSTs JSON there instead of
# Telegram (Authorization: Bearer when the key is set). Unset keeps the Telegram path.
HOUSE_OPS_WEBHOOK_URL=
HOUSE_OPS_WEBHOOK_KEY=

# A written notice that needs no house: a URL to POST to. {{json}} in the body is
# the notice as a quoted JSON string, {{text}} is it raw. Examples:
#   Slack/Discord   {"text":{{json}}}          application/json
#   ntfy            {{text}}                   text/plain
JARVIS_NOTIFY_WEBHOOK=
JARVIS_NOTIFY_WEBHOOK_BODY=
JARVIS_NOTIFY_WEBHOOK_CONTENT_TYPE=
JARVIS_NOTIFY_WEBHOOK_HEADERS=

# Repository and fine-grained token used to open and merge pull requests.
JARVIS_GITHUB_REPO=
GITHUB_TOKEN_JARVIS=
JARVIS_COMMIT_EMAIL=

# A pack reads its own variables from this same file and none of them are listed
# here: this repository carries no pack, so it cannot document one. Each pack's
# README has its table.
