[Unit]
Description=JARVIS weekly memory consolidation
Documentation=https://github.com/jrhimself/jarvis-core
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__JARVIS_USER__
Group=__JARVIS_USER__
WorkingDirectory=__JARVIS_ROOT__/brain
ExecStart=/usr/bin/node dist/consolidate-cli.js

Environment=NODE_ENV=production
Environment=HOME=__JARVIS_HOME__
Environment=PATH=__JARVIS_HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin
# Holds CLAUDE_CODE_OAUTH_TOKEN. Readable by root only; systemd reads it for us.
EnvironmentFile=-/etc/jarvis/jarvis.env

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# The agent SDK keeps its session state under ~/.claude, so that path must be writable.
ReadWritePaths=__JARVIS_ROOT__ __JARVIS_HOME__/.claude __JARVIS_HOME__/.cache __JARVIS_HOME__/.local
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

StandardOutput=journal
StandardError=journal
